<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  PLANTILLA (no instalada). Informe semanal de la cueva: cada lunes a las 07:30
  (media hora después del diario, para que incluya el del lunes).
  Corre codigo/automatizacion/semanal.py. Cómo instalarla y quitarla: codigo/automatizacion/LEEME.md
-->
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>com.cueva.semanal</string>
	<key>ProgramArguments</key>
	<array>
		<string>/Library/Frameworks/Python.framework/Versions/3.15/bin/python3</string>
		<string>/Users/david/Desktop/dAvId-Trading/codigo/automatizacion/semanal.py</string>
	</array>
	<key>WorkingDirectory</key>
	<string>/Users/david/Desktop/dAvId-Trading</string>
	<key>StartCalendarInterval</key>
	<dict>
		<key>Weekday</key><integer>1</integer>
		<key>Hour</key><integer>7</integer>
		<key>Minute</key><integer>30</integer>
	</dict>
	<key>StandardOutPath</key>
	<string>/Users/david/Desktop/dAvId-Trading/resultados/diario/launchd_semanal.log</string>
	<key>StandardErrorPath</key>
	<string>/Users/david/Desktop/dAvId-Trading/resultados/diario/launchd_semanal.log</string>
	<key>RunAtLoad</key>
	<false/>
</dict>
</plist>
